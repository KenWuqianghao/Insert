<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Insert.Views.ConfirmWindow"
        Title="Insert"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Icon="avares://Insert/Assets/Insert.ico"
        Background="{DynamicResource SettingsBackground}">
  <StackPanel Margin="24" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <PathIcon Data="{StaticResource Icon.Warning}" Width="22" Height="22" Foreground="{StaticResource NoticeOrange}" />
      <TextBlock Text="Clear the clipboard history?" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextPrimary}" />
    </StackPanel>
    <TextBlock Text="Insert deletes all clips that are not in a pinboard. You cannot undo this." TextWrapping="Wrap" FontSize="13"
               Foreground="{DynamicResource TextSecondary}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="ConfirmButton" Content="Clear History" Classes="accent" Click="Confirm" />
      <Button Content="Cancel" IsCancel="True" Click="Cancel" />
    </StackPanel>
  </StackPanel>
</Window>
